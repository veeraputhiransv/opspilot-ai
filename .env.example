# Copy to .env for local runs outside Docker. Docker Compose sets these itself.

OPSPILOT_MODE=demo
OPSPILOT_DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot
OPSPILOT_REDIS_URL=redis://localhost:6379/0
OPSPILOT_STEP_DELAY_MS=700
OPSPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPSPILOT_LOG_LEVEL=INFO

OPSPILOT_ENV=development
OPSPILOT_JWT_SECRET=replace-with-a-long-random-jwt-secret
OPSPILOT_VAULT_MASTER_KEY=
OPSPILOT_ACCESS_TOKEN_MINUTES=15
OPSPILOT_REFRESH_TOKEN_DAYS=14
OPSPILOT_BOOTSTRAP_ENABLED=false
OPSPILOT_DEMO_SEED_ENABLED=false
OPSPILOT_DEMO_PASSWORD=AcmeFlow-operator-12

# Shared API key is not product auth. Use register/login or workspace ingest keys.
OPSPILOT_API_KEY=

# Optional narrative rewrite. Severity, tool choice, and approval never follow the model.
OPSPILOT_LLM_ENABLED=false
OPSPILOT_OPENAI_API_KEY=
OPSPILOT_OPENAI_MODEL=gpt-4.1-mini
OPSPILOT_OPENAI_BASE_URL=https://api.openai.com/v1

# Real mode only. Destructive actions call these webhooks. They never open a shell.
OPSPILOT_GITHUB_TOKEN=
OPSPILOT_SLACK_WEBHOOK_URL=
OPSPILOT_ROLLBACK_WEBHOOK=
OPSPILOT_RESTART_WEBHOOK=
OPSPILOT_LOG_QUERY_URL=
OPSPILOT_SMTP_HOST=
OPSPILOT_SMTP_PORT=587
OPSPILOT_SMTP_USERNAME=
OPSPILOT_SMTP_PASSWORD=
OPSPILOT_SMTP_FROM=
